#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // =====================================================================
        // BASE
        // =====================================================================

        default_layer {
            display-name = "Base";

            // -----------------------------------------------------------------
            // | TAB | Q | W | E | R | T |   | Y | U | I | O | P | ESC |
            // | CTRL| A | S | D | F | G |   | H | J | K | L | ; | GUI |
            //       | SHFT| Z | X | C | V |   | B | N | M | , | . |
            //                    | ALT | LOW | SPC |   | ENT | RAI | BKSPC |
            // -----------------------------------------------------------------

            bindings = <
                &kp TAB    &kp Q       &kp W       &kp E       &kp R       &kp T
                &kp Y      &kp U       &kp I       &kp O       &kp P       &kp ESC

                &kp LCTRL  &kp A       &kp S       &kp D       &kp F       &kp G
                &kp H      &kp J       &kp K       &kp L       &kp SEMI    &kp RGUI

                &kp LSHFT  &kp Z       &kp X       &kp C       &kp V
                &kp B      &kp N       &kp M       &kp COMMA   &kp DOT

                &kp LALT   &mo 1       &kp SPACE
                &kp RET    &mo 2       &kp BSPC
            >;
        };

        // =====================================================================
        // LOWER
        // =====================================================================

        lower_layer {
            display-name = "Lower";

            // -----------------------------------------------------------------
            // | $ | @ | & | { | } |  _  |     | / | 7 | 8 | 9 | - | % |
            // | ^ | # | | | ( | ) |  "  |     | = | 4 | 5 | 6 | + | \ |
            //     | ? | ! | [ | ] |  '  |     | 0 | 1 | 2 | 3 | * |
            //         | ALT |     | SPC |     | ENT |     | BKSPC |
            // -----------------------------------------------------------------

            bindings = <
                &kp LS(N4)   &kp LS(N2)    &kp LS(N6)    &kp LS(LBKT)  &kp LS(RBKT)  &kp LS(MINUS)
                &kp FSLH     &kp N7        &kp N8        &kp N9        &kp MINUS     &kp LS(N5)

                &kp LS(N6)   &kp LS(N3)    &kp BSLH      &kp LS(N9)    &kp LS(N0)   &kp LS(N2)
                &kp EQUAL    &kp N4        &kp N5        &kp N6        &kp LS(EQUAL) &kp BSLH

                &kp LS(FSLH) &kp EXCL      &kp LBKT      &kp RBKT      &kp SINGLE_QUOTE
                &kp N0       &kp N1        &kp N2        &kp N3        &kp LS(N8)

                &kp LALT     &trans        &kp SPACE
                &kp RET      &studio_unlock        &kp BSPC
            >;
        };

        // =====================================================================
        // RAISE
        // =====================================================================

        raise_layer {
            display-name = "Raise";

            // -----------------------------------------------------------------
            // | TAB | PGUP | F9 | F10 | F11 | F12 |   | VOLUP | VOLDN | DISPUP | DISPDN | BT3 | BT5 |
            // | SHFT| PGDN | F5 | F6  | F7  | F8  |   | ←     | ↓     | ↑      | →      | BT2 | BT4   |
            // |     | HOME | F1 | F2  | F3  | F4  |   | >     | <     | :      | BTCLR  | BT1|
            //                   | ALT |     | SPC |   | ENT |     | BKSPC |
            // -----------------------------------------------------------------

            bindings = <
                &kp TAB       &kp PG_UP     &kp F9       &kp F10       &kp F11       &kp F12
                &kp C_VOL_UP  &kp C_VOL_DN  &kp C_BRI_UP &kp C_BRI_DN  &bt BT_SEL 3  &bt BT_SEL 4

                &kp LSHFT     &kp PG_DN     &kp F5       &kp F6        &kp F7        &kp F8
                &kp LEFT      &kp DOWN      &kp UP       &kp RIGHT     &bt BT_SEL 1  &bt BT_SEL 2

                &kp HOME      &kp F1       &kp F2        &kp F3        &kp F4
                &kp LS(COMMA) &kp LS(DOT)  &kp LS(SEMI)  &bt BT_CLR    &bt BT_SEL 0

                &kp LALT      &trans        &kp SPACE
                &kp RET       &trans        &kp BSPC
            >;
        };
    };
};
